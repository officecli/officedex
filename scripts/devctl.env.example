# Optional local overrides. Do not commit secrets here.
OFFICEDEX_DEVCTL_WEB_PORT_BASE=3100
OFFICEDEX_DEVCTL_API_PORT_BASE=18100
OFFICEDEX_DEVCTL_WAILS_PORT_BASE=34115
OFFICEDEX_DEVCTL_BRIDGE_PORT_BASE=37100
OFFICEDEX_DEVCTL_LEASE_TTL_MS=7200000
OFFICEDEX_DEVCTL_IDLE_TTL_MS=1800000
OFFICEDEX_DEVCTL_TERM_TIMEOUT_MS=5000

# Compile the browser bridge with deterministic local generation. Browser demo
# requests create local fixtures without login, OfficeCLI, or hosted Credits.
# OFFICEDEX_DEVCTL_BROWSER_DEMO=1
# OFFICEDEX_DEVCTL_BROWSER_DEMO_AUTH=anonymous
# OFFICEDEX_DEVCTL_BROWSER_DEMO_CREDITS=30

# Optional browser-only OfficeCLI binary for source-development sessions. This
# is instance identity, so switching it restarts the bridge without touching
# release/desktop behavior.
# OFFICEDEX_DEVCTL_OFFICECLI_BINARY=/absolute/path/to/officecli

# Tests may override the state directory. Normal development should keep the
# default ~/.cache/officedex-dev so all worktrees share the same coordinator.
# OFFICEDEX_DEVCTL_STATE_DIR=/absolute/path
