{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "OfficeDex",
  "outputfilename": "officedex",
  "frontend:dir": ".",
  "frontend:install": "npm install",
  "frontend:build": "bash scripts/build-frontend-desktop.sh",
  "frontend:dev:watcher": "npm run dev:browser",
  "frontend:dev:serverUrl": "http://localhost:3100",
  "wailsjsdir": "./src/renderer/generated",
  "version": "2",
  "author": {
    "name": "OfficeDex"
  },
  "info": {
    "productName": "OfficeDex",
    "productVersion": "1.0.15",
    "copyright": "",
    "comments": "OfficeDex desktop app (Wails v2 + Go)",
    "fileAssociations": [
      {
        "ext": "docx",
        "name": "Word Document",
        "role": "Editor",
        "iconName": "appicon"
      },
      {
        "ext": "xlsx",
        "name": "Excel Workbook",
        "role": "Editor",
        "iconName": "appicon"
      },
      {
        "ext": "pptx",
        "name": "PowerPoint Presentation",
        "role": "Editor",
        "iconName": "appicon"
      }
    ],
    "protocols": [
      {
        "scheme": "officedex",
        "role": "Viewer"
      }
    ]
  }
}
